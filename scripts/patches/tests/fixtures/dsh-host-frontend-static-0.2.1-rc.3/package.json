{
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "description": "SPA dist server for the Web shell: owns the webserver fallback seat, serving explicit index entries and static assets with traversal rejection and 404 misses",
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "name": "@deepseek-ai/dsh-host-frontend-static",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/frontend-static"
  },
  "type": "module",
  "types": "lib/types/index.d.ts",
  "version": "0.2.1-rc.3"
}
